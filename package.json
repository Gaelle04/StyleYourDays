{
  "name": "styleyourdays",
  "version": "2.0.0",
  "private": true,
  "description": "Style Your Days \u2014 an Angular fashion inspiration website",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "format": "prettier --write src tests *.json .github/workflows/main.yml README.md",
    "format:check": "prettier --check src tests *.json .github/workflows/main.yml README.md"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/router": "22.2.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.58.2",
    "prettier": "3.9.9",
    "typescript": "~6.0.2"
  }
}
